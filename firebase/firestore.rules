rules_version = '2';

// Security Rules für die Helferplanung (helferplanung.html) der
// Freiwilligen Feuerwehr Lorsbach e.V.
//
// Modell: Jede Planung ("event") gehört dem Gerät/Browser, das sie erstellt
// hat (ownerUid = anonyme Firebase-Auth-UID dieses Geräts). Jede Rückmeldung
// ("response") gehört analog dem Gerät, das sie abgegeben hat. Der
// Planungs-Ersteller darf zusätzlich fremde Rückmeldungen löschen
// (Moderation), sonst darf niemand fremde Daten verändern.
//
// Alles ist öffentlich LESBAR (Helfer und Ergebnis-Link funktionieren ohne
// Login), aber nur der jeweilige Eigentümer darf SCHREIBEN. Das erfordert
// keine Geheimnisse in der URL.
//
// Einrichtung: Firebase Console → Firestore Database → Regeln → diesen
// kompletten Inhalt einfügen und veröffentlichen. Siehe auch README.md,
// Abschnitt "Helferplanung einrichten".

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /events/{eventId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.shifts is list
        && request.resource.data.shifts.size() > 0
        && request.resource.data.active == true;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'location', 'shifts', 'active', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;

      match /responses/{responseId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && get(/databases/$(database)/documents/events/$(eventId)).data.active == true;

        allow update: if isSignedIn()
          && request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'contact', 'comment', 'answers', 'updatedAt']);

        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.ownerUid
              || request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid);
      }
    }
  }
}
